# 构建产物（`python tools/build.py` / `tools/fz_ctl.py` 生成）
/build/
/dist/

# 大型二进制与参考资料不入库（见 vendor/manifest.json 与 docs/协作/资源与命名规范.md）
/vendor/*
!/vendor/manifest.json
/source/

# 地图 WAD 由 tools/gen_maps.py 生成，源码是生成器本身
/game/maps/*.wad
# 字体图集由 tools/gen_font.py 从源码字符串自动生成
/game/fonts/

# Python
__pycache__/
*.pyc
.venv/

# 测试暂存 / 本地克隆验证（体积大，不入库）
/_staging/
/D__fztest/
*.log

# 2K 生成草稿（每张 150-250KB，可由 生图/pixelpipe 重出）。母版 art/sprites/ 才是
# 交付物，几 KB 一张，正常入库。
/art/source/

# 音效预听包（`python tools/gen_sfx.py` 重出，成品在 game/sounds/）
/sfx_preview/

# 编辑器与系统
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# AI 助手的工作区数据（记忆、日志），不属于仓库内容
/.workbuddy/

# 文档的 PDF 导出（由 .md 生成，用于外发；入库会和源文件双份漂移）
/docs/*.pdf
