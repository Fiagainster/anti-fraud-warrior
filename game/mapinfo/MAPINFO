// 反诈战士 · MAPINFO
// 音乐：game/music/*.ogg（OGG Vorbis q5，44.1k 立体声，-16 LUFS），
// 循环点已写进 Vorbis 注释的 LOOP_START/LOOP_END（单位：采样）。
// 曲目说明与规格见 docs/音频设计.md §4。
gameinfo
{
	statusbarclass = "FZStatusBar"
	eventhandlers = "FZPlayEvents"
	titleMusic = "music/title.ogg"
	// 标题页与轮播介绍页（替代 Freedoom 自带的那几张）
	titlePage = "TITLEPIC"
	titleTime = 12
	creditPage = "FZCRED1"
	addcreditPage = "FZCRED2"
	pageTime = 8
	advisoryTime = 0
	// 结局：没有下一张图时走这个 end sequence（六个敌人巡礼 -> 终章图 -> 回标题）
	defaultendsequence = "FZ_END"
}

// 怪物巡礼：一只一屏，按一下键让当前这只倒下，然后换下一只；
// 最后一张终章图，再按键回标题。不想看可以 ESC 打开菜单退出。
intermission FZ_END
{
	cast { CastClass = "FZShill"    Background = "FZCASTBG" }
	cast { CastClass = "FZRunner"   Background = "FZCASTBG" }
	cast { CastClass = "FZScalper"  Background = "FZCASTBG" }
	cast { CastClass = "FZBroker"   Background = "FZCASTBG" }
	cast { CastClass = "FZFakeCop"  Background = "FZCASTBG" }
	cast { CastClass = "FZChairman" Background = "FZCASTBG" }
	image { Background = "FZENDPIC" }
}


doomednums
{
	3920 = FZGate11
	3921 = FZGate12
	3922 = FZGate21
	3923 = FZGate22
	3924 = FZGate31
	3925 = FZGate32
	3930 = FZEvidencePickup
	3931 = FZMasterProof
	3932 = FZBriefingActor
}

clearepisodes
episode FZ01 { name = "反诈战士：净网行动" }

// Standard Doom flow: exit switch -> intermission (stats) -> Enter -> next
// map. FZ03 has no Next, so the run ends with the engine's end sequence.
// Music 用完整路径：引擎 S_ChangeMusic -> FindMusic -> CheckNumForFullName，
// 能直接找到 PK3 内的 music/chN.ogg；不再依赖 Freedoom 的 $MUSIC_E1M* 别名。
// boss.ogg 暂无宿主（三章还没有 Boss 关），做 Boss 关时在该图写 Music = "music/boss.ogg"。
map FZ01 "第一章：刷单深渊" { Next = "FZ02" Sky1 = "SKY1" Music = "music/ch1.ogg" }
map FZ02 "第二章：装备黑市" { Next = "FZ03" Sky1 = "SKY1" Music = "music/ch2.ogg" }
map FZ03 "第三章：警服幻影" { Sky1 = "SKY1" Music = "music/ch3.ogg" }

